generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum Role {
  USER
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RequestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProblemType {
  MEDICAL
  FOOD
  EVACUATION
  SHELTER
  REPAIR
  PSYCHOLOGICAL
}

enum District {
  ALMALYNSKIY
  AUEZOVSKIY
  BOSTANDYQ
  MEDEU
  NAURYZBAY
  TURKSIB
  ZHETYSU
  ALATAU
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  ACTIVE
  RESOLVING
  RESOLVED
}

// ==============================
// MODELS
// ==============================

model User {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String @unique
  phone        String @unique
  passwordHash String
  role         Role   @default(USER)

  isEmailVerified  Boolean   @default(false)
  telegramUsername String?   @db.VarChar(64)
  telegramChatId   String? 
  district         District?
  avatarUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?

  // Заявки созданные пользователем
  createdRequests   Request[] @relation("RequestCreatedBy")

  // Заявки опубликованные координатором
  publishedRequests Request[] @relation("RequestPublishedBy")

  // Участие волонтёра в заявках (many-to-many)
  volunteerRequests RequestVolunteer[]

  // Инциденты созданные координатором/админом
  createdIncidents Incident[] @relation("IncidentCreatedBy")

  @@map("users")
}

model Request {
  id Int @id @default(autoincrement())

  problemType ProblemType
  title       String
  description String
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(NEW)

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedById Int?
  publishedBy   User?     @relation("RequestPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  peopleCount Int      @default(1)
  address     String
  district    District
  landmark    String?


  latitude  Float?
  longitude Float?

  contactName     String
  contactPhone    String
  contactEmail    String?
  contactTelegram String?
  additionalInfo  String?

  consentAt DateTime

  createdById Int
  createdBy   User @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  volunteers RequestVolunteer[]
  telegramMessages RequestTelegramMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([problemType])
  @@index([district])
  @@index([isPublished])
  @@map("requests")
}

model RequestVolunteer {
  requestId   Int
  volunteerId Int
  assignedAt  DateTime @default(now())

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteer User    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@id([requestId, volunteerId])
  @@index([volunteerId])
  @@index([requestId])
  @@map("request_volunteers")
}

model Incident {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(ACTIVE)
  district    District

  createdById Int
  createdBy   User @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([district])
  @@map("incidents")
}

model RequestTelegramMessage {
  id        Int    @id @default(autoincrement())
  requestId Int
  chatId    String
  messageId Int

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_telegram_messages")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}