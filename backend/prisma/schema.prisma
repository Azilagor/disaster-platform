generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum Role {
  USER
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RequestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProblemType {
  MEDICAL
  FOOD
  EVACUATION
  SHELTER
  REPAIR
  PSYCHOLOGICAL
}

enum District {
  ALMALYNSKIY
  AUEZOVSKIY
  BOSTANDYQ
  MEDEU
  NAURYZBAY
  TURKSIB
  ZHETYSU
  ALATAU
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  ACTIVE
  RESOLVING
  RESOLVED
}

// Тип действия для лога активности
enum ActivityAction {
  USER_REGISTERED
  USER_LOGIN
  USER_ROLE_CHANGED
  USER_DELETED
  REQUEST_CREATED
  REQUEST_UPDATED
  REQUEST_PUBLISHED
  REQUEST_UNPUBLISHED
  REQUEST_STATUS_CHANGED
  REQUEST_DELETED
  VOLUNTEER_ASSIGNED
  VOLUNTEER_UNASSIGNED
  VOLUNTEER_JOINED
  VOLUNTEER_LEFT
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_STATUS_CHANGED
  INCIDENT_DELETED
}

// ==============================
// MODELS
// ==============================

model User {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String @unique
  phone        String @unique
  passwordHash String
  role         Role   @default(USER)

  isEmailVerified  Boolean   @default(false)
  telegramUsername String?   @db.VarChar(64)
  telegramChatId   String?
  district         District?
  avatarUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?

  createdRequests   Request[]  @relation("RequestCreatedBy")
  publishedRequests Request[]  @relation("RequestPublishedBy")
  volunteerRequests RequestVolunteer[]
  createdIncidents  Incident[] @relation("IncidentCreatedBy")

  // Лог действий пользователя
  activityLogs ActivityLog[]

  @@map("users")
}

model Request {
  id Int @id @default(autoincrement())

  problemType ProblemType
  title       String
  description String
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(NEW)

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  publishedById Int?
  publishedBy   User?     @relation("RequestPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  peopleCount Int      @default(1)
  address     String
  district    District
  landmark    String?

  latitude  Float?
  longitude Float?

  contactName     String
  contactPhone    String
  contactEmail    String?
  contactTelegram String?
  additionalInfo  String?

  consentAt DateTime

  createdById Int
  createdBy   User @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Связь с инцидентом (необязательная)
  incidentId Int?
  incident   Incident? @relation("IncidentRequests", fields: [incidentId], references: [id], onDelete: SetNull)

  volunteers       RequestVolunteer[]
  telegramMessages RequestTelegramMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([problemType])
  @@index([district])
  @@index([isPublished])
  @@index([incidentId])
  @@map("requests")
}

model RequestVolunteer {
  requestId   Int
  volunteerId Int
  assignedAt  DateTime @default(now())

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteer User    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@id([requestId, volunteerId])
  @@index([volunteerId])
  @@index([requestId])
  @@map("request_volunteers")
}

model Incident {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(ACTIVE)
  district    District

  createdById Int
  createdBy   User @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Заявки привязанные к инциденту
  requests Request[] @relation("IncidentRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([district])
  @@map("incidents")
}

model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  entityType String         // "request" | "user" | "incident" | "volunteer"
  entityId   Int?
  meta       Json?          // дополнительные данные (старый статус, новый статус и т.д.)

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model RequestTelegramMessage {
  id        Int    @id @default(autoincrement())
  requestId Int
  chatId    String
  messageId Int

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_telegram_messages")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model NewsItem {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique  // slug или URL-идентификатор статьи
  title       String
  description String?
  imageUrl    String?
  sourceUrl   String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@map("news_items")
}

model NewsItem {
  id          Int      @id @default(autoincrement())
  title       String
  url         String   @unique
  imageUrl    String?
  description String?
  publishedAt DateTime?
  source      String   @default("tengrinews")
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([source])
  @@map("news_items")
}