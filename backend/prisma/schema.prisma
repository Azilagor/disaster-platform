generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RequestPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProblemType {
  MEDICAL
  FOOD
  EVACUATION
  SHELTER
  REPAIR
  PSYCHOLOGICAL
}

enum District {
  ALMALYNSKIY
  AUEZOVSKIY
  BOSTANDYQ
  MEDEU
  NAURYZBAY
  TURKSIB
  ZHETYSU
  ALATAU
}

model User {
  id           Int    @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String @unique
  phone        String @unique
  passwordHash String
  role         Role   @default(USER)

  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?

  // Requests relations
  createdRequests  Request[] @relation("RequestCreatedBy")
  assignedRequests Request[] @relation("RequestAssignedTo")

  @@map("users")
}

model Request {
  id Int @id @default(autoincrement())

  problemType ProblemType
  title       String
  description String
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(NEW)

  peopleCount Int      @default(1)
  address     String
  district    District
  landmark    String?

  contactName     String
  contactPhone    String
  contactEmail    String?
  contactTelegram String?
  additionalInfo  String?

  consentAt DateTime

  createdById Int
  createdBy   User @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId Int?
  assignedTo   User? @relation("RequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([problemType])
  @@index([district])
  @@map("requests")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}
